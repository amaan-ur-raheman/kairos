EXPO_PUBLIC_SERVER_URL=https://api.example.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# These identifiers must match the Google Cloud, Clerk, and store registrations.
KAIROS_ANDROID_PACKAGE=com.amaan.kairos
KAIROS_IOS_BUNDLE_IDENTIFIER=com.amaan.kairos

# Configure these in Clerk and Google Cloud before a native production build.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=replace_me.apps.googleusercontent.com
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=replace_me.apps.googleusercontent.com
# Required for iOS builds:
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=replace_me.apps.googleusercontent.com
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.replace_me
