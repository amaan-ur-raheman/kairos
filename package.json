{
  "name": "kairos",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "@tanstack/react-query": "^5.101.4",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@orpc/tanstack-query": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@types/react-dom": "^19.2.3",
      "tailwind-merge": "^3.6.0",
      "drizzle-orm": "^0.45.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @kairos/db --",
    "db:studio": "turbo run db:studio -F @kairos/db --",
    "db:generate": "turbo run db:generate -F @kairos/db --",
    "db:migrate": "turbo run db:migrate -F @kairos/db --",
    "deploy:setup": "vercel link",
    "dev:vercel": "vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "deploy:check": "vercel deploy --dry"
  },
  "dependencies": {
    "@kairos/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kairos/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vercel": "^58.1.0"
  },
  "packageManager": "bun@1.4.0"
}
